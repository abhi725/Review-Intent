# --- database ---
POSTGRES_DB=intentdesk
POSTGRES_USER=intentdesk
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://intentdesk:CHANGEME@127.0.0.1:5433/intentdesk

# --- app ---
APP_ENV=dev
API_PORT=8100
MCP_HTTP_PORT=8110
SESSION_SECRET=

# --- auth (Google OAuth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only used by the 'domain' and 'allowlist' access modes.
# Empty means no domain restriction; access_mode=open ignores it entirely.
ALLOWED_EMAIL_DOMAIN=
ACCESS_MODE=open

# --- outbound mail (verification + password reset) ---
# Absolute base for links we email. NOT derived from the request Host header:
# an attacker who can set that header could otherwise redirect a reset link.
# Must be the public URL, e.g. https://intent.swandigitals.com
PUBLIC_BASE_URL=http://localhost:8100
#
# Mautic is the intended channel — templates are editable without a deploy and
# every send lands on the contact timeline. Create two templates plus a custom
# contact field named `action_url`, and put their IDs here.
MAUTIC_URL=https://mail.swandigitals.com
MAUTIC_USER=
MAUTIC_PASS=
MAUTIC_TPL_VERIFY=0
MAUTIC_TPL_RESET=0
#
# Fallback, used whenever Mautic is unreachable or refuses. Keep it configured:
# Mautic's API auth has broken before without anyone noticing, because mail kept
# arriving through this path. Check the logs for "mautic send failed".
RESEND_API_KEY=
EMAIL_FROM=Intent Desk <noreply@updates.swandigitals.com>
#
# With neither configured, signup still works and the admin issues reset and
# confirmation links by hand from the Users screen.

# --- targeting defaults (Settings screen overrides these at runtime) ---
TARGET_COUNTRY=IN
TARGET_AGENTS_MIN=5
TARGET_AGENTS_MAX=200
SIGNAL_RECENCY_DAYS=180
MONTHLY_SPEND_CAP_USD=35

# --- providers (Phase 2; leave blank until you have them) ---
ANTHROPIC_API_KEY=
BUILTWITH_API_KEY=
APIFY_TOKEN=
APOLLO_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=swan-intent-desk/0.1
