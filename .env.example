# --- database ---
POSTGRES_DB=intentdesk
POSTGRES_USER=intentdesk
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://intentdesk:CHANGEME@127.0.0.1:5433/intentdesk

# --- app ---
APP_ENV=dev
API_PORT=8100
MCP_HTTP_PORT=8110
SESSION_SECRET=

# --- auth (Google OAuth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAIN=swandigitals.com

# --- targeting defaults (Settings screen overrides these at runtime) ---
TARGET_COUNTRY=IN
TARGET_AGENTS_MIN=5
TARGET_AGENTS_MAX=200
SIGNAL_RECENCY_DAYS=180
MONTHLY_SPEND_CAP_USD=35

# --- providers (Phase 2; leave blank until you have them) ---
ANTHROPIC_API_KEY=
BUILTWITH_API_KEY=
APIFY_TOKEN=
APOLLO_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=swan-intent-desk/0.1
