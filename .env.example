# --- database ---
POSTGRES_DB=intentdesk
POSTGRES_USER=intentdesk
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://intentdesk:CHANGEME@127.0.0.1:5433/intentdesk

# --- app ---
APP_ENV=dev
API_PORT=8100
MCP_HTTP_PORT=8110
SESSION_SECRET=

# --- auth (Google OAuth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only used by the 'domain' and 'allowlist' access modes.
# Empty means no domain restriction; access_mode=open ignores it entirely.
ALLOWED_EMAIL_DOMAIN=
ACCESS_MODE=open

# --- outbound mail (verification + password reset) ---
# Absolute base for links we email. NOT derived from the request Host header:
# an attacker who can set that header could otherwise redirect a reset link.
# Must be the public URL, e.g. https://intent.swandigitals.com
PUBLIC_BASE_URL=http://localhost:8100
#
# Mautic is the intended channel — templates are editable without a deploy and
# every send lands on the contact timeline. Create two templates plus a custom
# contact field named `action_url`, and put their IDs here.
MAUTIC_URL=https://mail.swandigitals.com
MAUTIC_USER=
MAUTIC_PASS=
MAUTIC_TPL_VERIFY=0
MAUTIC_TPL_RESET=0
#
# Fallback, used whenever Mautic is unreachable or refuses. Keep it configured:
# Mautic's API auth has broken before without anyone noticing, because mail kept
# arriving through this path. Check the logs for "mautic send failed".
RESEND_API_KEY=
EMAIL_FROM=Intent Desk <noreply@updates.swandigitals.com>
#
# With neither configured, signup still works and the admin issues reset and
# confirmation links by hand from the Users screen.

# --- targeting defaults (Settings screen overrides these at runtime) ---
TARGET_COUNTRY=IN
TARGET_AGENTS_MIN=5
TARGET_AGENTS_MAX=200
SIGNAL_RECENCY_DAYS=180
MONTHLY_SPEND_CAP_USD=35

# --- LLM (drafting and complaint classification) ---
# With neither key set the API still starts and still serves the dashboard;
# /cron/classify and /cron/draft are what stop working, and they report the
# provider error rather than failing the request. gpt-4o is primary,
# gemini-2.5-flash the fallback.
LLM_PROVIDER=openai
LLM_FALLBACK_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- scheduler and MCP auth ---
# One token guards /mcp and every /cron/* endpoint. Leave it blank and both
# return 503 rather than opening: an unconfigured endpoint is not a public one.
# Generate with: openssl rand -base64 32
MCP_BEARER_TOKEN=

# --- providers (Phase 2; leave blank until you have them) ---
ANTHROPIC_API_KEY=
BUILTWITH_API_KEY=
APIFY_TOKEN=
APOLLO_API_KEY=
# Google Sheets push (preferred over the public CSV below -- nothing is exposed).
# Service account JSON key, base64-encoded:
#   base64 -w0 sheets-sa.json
# The spreadsheet must be shared with the key's client_email as Editor, and the
# Sheets API enabled on its project.
GOOGLE_SHEETS_SA_JSON=
GOOGLE_SHEETS_ID=

# Public CSV export for Google Sheets IMPORTDATA. ANYONE WITH THIS URL CAN READ
# THE LEAD QUEUE -- IMPORTDATA cannot send an Authorization header, so the secret
# has to be the URL itself. Empty disables the route, which is the default.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SHEET_EXPORT_TOKEN=

# Apify residential proxy — needs a PAID Apify plan. `false` keeps Capterra,
# TrustRadius and SoftwareSuggest reporting as blocked instead of billable.
# The proxy password is NOT the API token: GET /v2/users/me -> data.proxy.password
APIFY_RESIDENTIAL_PROXY=false
APIFY_PROXY_PASSWORD=
